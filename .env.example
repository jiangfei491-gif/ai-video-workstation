# 复制为 .env.local 并填入真实密钥（.env.local 不进入 Git）
# cp .env.example .env.local

# ── Workspace ──────────────────────────────────────────────
# AI_VIDEO_OS_ROOT=~/AI Video OS
# WORKSPACE_ROOT=/path/to/workspace

# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# OPENAI_EVOLUTION_MODEL=gpt-4.1

# ── Google / Veo / Gemini ────────────────────────────────────
VEO_API_KEY=
VEO_MODEL_ID=veo-3.1-generate-preview
VEO_ASPECT_RATIO=9:16
VEO_DURATION_SECONDS=8
# VEO_API_MODE=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_TEXT_MODEL=gemini-2.0-flash

# ── Anthropic / DeepSeek（脚本进化、多模型，可选）────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# ── 图片生成 Tier1 — BFL FLUX（推荐）────────────────────────
BFL_API_KEY=
# BFL_API_BASE=https://api.bfl.ai

# 可选 — FAL 托管 FLUX
# FAL_KEY=
# FAL_API_KEY=

# ── 配音中心 — ElevenLabs 云端 ───────────────────────────────
# ELEVENLABS_API_KEY=

# 配音中心 — 本地 TTS（部署后填写实际地址）
# FISH_SPEECH_ENDPOINT=http://127.0.0.1:8000
# COSYVOICE_ENDPOINT=http://127.0.0.1:9880
# F5_TTS_ENDPOINT=http://127.0.0.1:7860
# LOCAL_TTS_TIMEOUT_MS=90000

# 批量配音限速（降低 Edge TTS 限流概率，毫秒）
# VOICE_BATCH_GAP_MS=350
# VOICE_BATCH_GAP_JITTER_MS=150
# EDGE_TTS_MAX_ATTEMPTS=8
# EDGE_TTS_BACKOFF_BASE_MS=800
# EDGE_TTS_BACKOFF_CAP_MS=12000

# ── 素材 / 资源爬虫（可选）──────────────────────────────────
# YOUTUBE_API_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# UNSPLASH_ACCESS_KEY=
# FREESOUND_API_KEY=
# JAMENDO_CLIENT_ID=
# SUBDL_API_KEY=
# CIVITAI_API_KEY=

# ── Intelligence / 模型仓库（可选）──────────────────────────
# HF_TOKEN=
# HUGGINGFACE_TOKEN=
# GITHUB_TOKEN=
# MODELSCOPE_TOKEN=

# ── 基础设施（可选）────────────────────────────────────────
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# ── OpenCut 高级编辑（iframe）───────────────────────────────
# NEXT_PUBLIC_OPENCUT_EDITOR_URL=https://opencut.app/projects
# OPENCUT_PROXY_TARGET=http://localhost:3000
# NEXT_PUBLIC_OPENCUT_LOCALE=zh

# ── PostgreSQL / Repository（见 database/.env.example）──────
# DATABASE_URL=postgresql://ai_cut:ai_cut_dev@localhost:5433/ai_cut_v1
# REDIS_URL=
# REDIS_ENABLED=false
# REPOSITORY_MODE=legacy
# AI_CUT_DUAL_WRITE=false
