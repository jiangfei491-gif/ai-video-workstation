# AI Video OS — PostgreSQL（M0 本地默认）
DATABASE_URL=postgresql://ai_cut:ai_cut_dev@localhost:5433/ai_cut_v1

# Workspace Root（统一工作目录）
AI_VIDEO_OS_ROOT=~/AI Video OS
# WORKSPACE_ROOT=/Volumes/SSD/AI Video OS

# Storage（默认 Local — root 由 WorkspaceManager 解析）
STORAGE_PROVIDER=local

# Redis（默认关闭）
REDIS_ENABLED=false

# Repository（P2 默认）
REPOSITORY_MODE=legacy
AI_CUT_DUAL_WRITE=false
AI_CUT_MIGRATION_EXECUTE=false
